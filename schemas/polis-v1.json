{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "modelVersion",
    "evidenceClass",
    "config",
    "cells"
  ],
  "properties": {
    "schemaVersion": {
      "const": "polis-v1"
    },
    "modelVersion": {
      "const": "axiom-decision-into-barter-v1"
    },
    "evidenceClass": {
      "const": "synthetic simulation"
    },
    "config": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "seed",
        "steps",
        "trials",
        "climates"
      ],
      "properties": {
        "climates": {
          "const": [
            "moderate",
            "stress"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "trials": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "climate",
          "first",
          "summaries",
          "contrast"
        ],
        "properties": {
          "summaries": {
            "type": "object",
            "required": [
              "material",
              "joint",
              "cautious",
              "fixedPrior"
            ]
          }
        }
      }
    }
  }
}
