{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNAPSE local model observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidence",
    "sequence",
    "taskId",
    "taskFamily",
    "condition",
    "requestSha256",
    "replicate",
    "id",
    "timestamp",
    "raw",
    "finishReason",
    "answer",
    "confidence",
    "providerResponseId",
    "tokens",
    "error",
    "latencyMs",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidence": {
      "const": "actual-model-execution"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "taskId": {
      "type": "string",
      "pattern": "^(pilot|development)-[0-9]{3}$"
    },
    "taskFamily": {
      "enum": [
        "multiplication",
        "remaining",
        "change",
        "conditional",
        "mean",
        "ordering"
      ]
    },
    "condition": {
      "enum": [
        "neutral",
        "incorrectCue"
      ]
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replicate": {
      "const": 1
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "finishReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer": {
      "enum": [
        null,
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "providerResponseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "enum": [
        null,
        "collector-interrupted",
        "local-inference-timeout",
        "invalid-or-unavailable-local-server-response"
      ]
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "scorable",
        "abstention",
        "missingConfidence",
        "missingAnswer",
        "invalidOutput",
        "explicitRefusal",
        "truncated",
        "timeout",
        "interrupted",
        "infrastructureFailure"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "scorable"
          }
        }
      },
      "then": {
        "properties": {
          "raw": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "confidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "missingConfidence"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "string"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "status": {
              "not": {
                "const": "scorable"
              }
            }
          }
        },
        "then": {
          "properties": {
            "answer": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "timeout",
              "interrupted",
              "infrastructureFailure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "raw": {
            "type": "null"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "raw": {
            "type": "string"
          },
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
