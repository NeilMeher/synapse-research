{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "organization",
    "title",
    "officialUrl",
    "retrievalDate",
    "geography",
    "units",
    "classification",
    "vintage",
    "revisionStatus",
    "format",
    "license",
    "redistribution",
    "extraction",
    "transformation",
    "missingValues",
    "limitations",
    "verificationStatus",
    "evidenceClass"
  ],
  "properties": {
    "schemaVersion": {
      "const": "source-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "officialUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "retrievalDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceClass": {
      "enum": [
        "Verified official observation",
        "Verified manufacturer specification",
        "Published research estimate",
        "Documented historical observation",
        "Derived value",
        "Modelled estimate",
        "User-defined scenario",
        "Illustrative assumption",
        "Unknown or unavailable input"
      ]
    }
  }
}
